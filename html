<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SASHRUT AYURVEDA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--neem:#2f4a35;--neem-d:#213826;--turmeric:#d99a1c;--sand:#ece2cc;--paper:#f8f3e6;--ink:#33241a;--muted:#7a6753;--line:#d8c9a8;--clay:#a4482a;
--serif:'Fraunces',Georgia,'Times New Roman',serif;--sans:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif}
*{box-sizing:border-box;margin:0}
body{font-family:var(--sans);background:var(--sand);color:var(--ink);line-height:1.6;min-height:100vh;display:flex;flex-direction:column}
h1,h2,h3,.logo{font-family:var(--serif);line-height:1.2}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--turmeric);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
main{flex:1}
/* nav */
header{background:var(--neem-d);color:var(--paper);position:sticky;top:0;z-index:10}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-size:1.25rem;font-weight:700;letter-spacing:.06em}
.cart-link{position:relative;display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;transition:background .2s}
.cart-link:hover{background:rgba(255,255,255,.12)}
.badge{background:var(--turmeric);color:var(--ink);font-size:.75rem;font-weight:700;min-width:22px;height:22px;border-radius:11px;display:grid;place-items:center;padding:0 6px}
/* hero */
.hero{background:var(--neem);color:var(--paper);padding:72px 0 80px;border-bottom:6px solid var(--turmeric)}
.hero h1{font-size:clamp(2.2rem,6vw,4rem);max-width:15ch;font-weight:700}
.hero p{max-width:46ch;margin-top:16px;color:#e4dcc3;font-size:1.1rem}
.btn{display:inline-block;border:0;border-radius:6px;padding:12px 22px;font-weight:700;transition:transform .2s,background .2s}
.btn-primary{background:var(--turmeric);color:var(--ink)}
.btn-primary:hover{background:#e8ab2f;transform:translateY(-2px)}
.btn-dark{background:var(--neem);color:var(--paper)}
.btn-dark:hover{background:var(--neem-d)}
.btn-line{background:transparent;border:2px solid var(--neem);color:var(--neem)}
.btn-line:hover{background:var(--neem);color:var(--paper)}
.btn[disabled]{opacity:.55;cursor:not-allowed;transform:none}
.hero .btn{margin-top:28px}
/* filters */
.section{padding:48px 0}
.section h2{font-size:1.8rem;margin-bottom:18px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}
.chip{border:1.5px solid var(--neem);background:transparent;color:var(--neem);padding:6px 16px;border-radius:999px;font-weight:500;transition:all .2s}
.chip:hover{background:rgba(47,74,53,.1)}
.chip.on{background:var(--neem);color:var(--paper)}
/* grid & cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;display:flex;flex-direction:column;transition:transform .3s ease,box-shadow .3s ease}
.card:hover{transform:translateY(-6px);box-shadow:0 14px 28px rgba(51,36,26,.18)}
.card .img{aspect-ratio:1/1;overflow:hidden;background:var(--line)}
.card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.card:hover img{transform:scale(1.06)}
.card .body{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
.cat{color:var(--muted);font-size:.85rem}
.card h3{font-size:1.15rem}
.price{font-weight:700;font-size:1.1rem;color:var(--clay)}
.card .btn{margin-top:auto;width:100%}
.in-cart{background:var(--neem);color:var(--paper)}
.empty{padding:60px 0;text-align:center;color:var(--muted)}
/* product page */
.crumb{display:inline-block;margin:28px 0 8px;color:var(--neem);font-weight:500}
.crumb:hover{text-decoration:underline}
.pdp{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:24px}
.main-img{aspect-ratio:1/1;border-radius:10px;overflow:hidden;background:var(--line);border:1px solid var(--line)}
.main-img img{width:100%;height:100%;object-fit:cover;display:block}
.thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.thumbs button{width:70px;height:70px;border:2px solid transparent;border-radius:8px;padding:0;overflow:hidden;background:none;transition:border-color .2s}
.thumbs button.on,.thumbs button:hover{border-color:var(--turmeric)}
.thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.pdp h1{font-size:2.2rem;margin:4px 0 10px}
.pdp .price{font-size:1.6rem}
.pdp p.desc{margin:16px 0;max-width:60ch}
.stock{font-size:.9rem;color:var(--muted);margin-bottom:16px}
.stock.low{color:var(--clay);font-weight:500}
.buy{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.qty{display:inline-flex;align-items:center;border:1.5px solid var(--neem);border-radius:6px;overflow:hidden;background:var(--paper)}
.qty button{width:38px;height:40px;border:0;background:transparent;font-size:1.2rem;color:var(--neem)}
.qty button:hover{background:rgba(47,74,53,.12)}
.qty span{min-width:38px;text-align:center;font-weight:700}
/* cart */
.page-title{font-size:2rem;margin:36px 0 20px}
.row{display:grid;grid-template-columns:80px 1fr auto auto auto;gap:16px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:12px}
.row img{width:80px;height:80px;object-fit:cover;border-radius:8px;display:block}
.row .name{font-family:var(--serif);font-weight:500;font-size:1.05rem}
.row .name:hover{text-decoration:underline}
.remove{background:none;border:0;color:var(--clay);font-weight:500;text-decoration:underline}
.total-bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin:24px 0 48px;padding:20px;background:var(--neem);color:var(--paper);border-radius:10px}
.total-bar strong{font-family:var(--serif);font-size:1.6rem}
/* checkout */
.co{display:grid;grid-template-columns:1.3fr 1fr;gap:32px;margin-bottom:56px;align-items:start}
.panel{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:24px}
.panel h2{font-size:1.3rem;margin-bottom:14px}
label{display:block;font-weight:500;margin:14px 0 4px}
input,textarea{width:100%;font:inherit;padding:10px 12px;border:1.5px solid var(--line);border-radius:6px;background:#fff;color:var(--ink)}
input:focus,textarea:focus{outline:none;border-color:var(--neem);box-shadow:0 0 0 3px rgba(217,154,28,.35)}
.sum-line{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--line)}
.sum-total{display:flex;justify-content:space-between;font-weight:700;font-size:1.2rem;padding-top:14px}
.msg{margin-top:14px;padding:12px;border-radius:6px}
.msg.err{background:#f6dcd2;color:#7a2a12}
.success{text-align:center;padding:80px 20px}
.success h1{font-size:2.2rem;color:var(--neem);margin-bottom:10px}
footer{background:var(--neem-d);color:#d9d0b6;text-align:center;padding:24px 20px;font-size:.9rem}
@media(max-width:760px){
 .pdp,.co{grid-template-columns:1fr}
 .row{grid-template-columns:64px 1fr auto;grid-template-areas:"i n r" "i q t"}
 .row img{width:64px;height:64px;grid-area:i}.row .name{grid-area:n}.row .rm{grid-area:r}.row .qtyc{grid-area:q}.row .lt{grid-area:t;text-align:right}
 .hero{padding:48px 0 56px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header><div class="wrap nav">
  <a href="#/" class="logo" id="logo"></a>
  <a href="#/cart" class="cart-link" aria-label="Cart">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 7H6"/></svg>
    <span class="badge" id="count">0</span>
  </a>
</div></header>
<main id="app"></main>
<footer id="foot"></footer>

<script>
/* ============ CONFIG — edit these ============ */
const CONFIG = {
  storeName: "SASHRUT AYURVEDA",
  tagline: "Time-honoured herbal care, made for everyday life.",
  formspreeUrl: "https://formspree.io/f/YOUR_FORM_ID", // paste your Formspree endpoint here
  currency: "₹"
};

/* ============ PRODUCTS — edit this array ============
   Each product: id (unique), name, price (number), category, description,
   images (array of URLs; first one is the main image), stock (number).
   The ph() helper only makes sample placeholder pictures — replace with real image URLs. */
const ph = (t, a, b) => "data:image/svg+xml;utf8," + encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='${a}'/><stop offset='1' stop-color='${b}'/></linearGradient></defs><rect width='400' height='400' fill='url(#g)'/><text x='200' y='210' font-family='Georgia,serif' font-size='30' text-anchor='middle' fill='#fff8e6'>${t}</text></svg>`);

const PRODUCTS = [
  { id: 1, name: "Ashwagandha Capsules", price: 499, category: "Supplements",
    description: "Pure root extract capsules, traditionally used to support calm energy and balanced stress response. 60 capsules per bottle.",
    images: [ph("Ashwagandha", "#7a5a2e", "#3d2b14"), ph("60 capsules", "#8c6a3a", "#4a3419")], stock: 25 },
  { id: 2, name: "Triphala Powder", price: 249, category: "Supplements",
    description: "A classic blend of amla, haritaki and bibhitaki. Mix a teaspoon in warm water at bedtime. 200 g pack.",
    images: [ph("Triphala", "#5e6b34", "#2f3a17")], stock: 40 },
  { id: 3, name: "Kumkumadi Face Oil", price: 899, category: "Skin Care",
    description: "Saffron-infused facial oil with sandalwood and manjistha for a soft, even-looking glow. 30 ml glass bottle.",
    images: [ph("Kumkumadi", "#c98a1a", "#8a4b12"), ph("Face Oil 30ml", "#d99a1c", "#9a5a14")], stock: 12 },
  { id: 4, name: "Neem & Tulsi Face Wash", price: 199, category: "Skin Care",
    description: "Gentle herbal cleanser that clears oil and dust without stripping skin. Suitable for daily use. 100 ml.",
    images: [ph("Neem & Tulsi", "#3f6b3a", "#1f3a20")], stock: 60 },
  { id: 5, name: "Bhringraj Hair Oil", price: 349, category: "Hair Care",
    description: "Slow-cooked in sesame oil with bhringraj and amla. Massage into the scalp before washing. 200 ml.",
    images: [ph("Bhringraj Oil", "#2b3a2a", "#101a10"), ph("200 ml", "#3a4a36", "#16231a")], stock: 30 },
  { id: 6, name: "Shikakai & Reetha Shampoo", price: 279, category: "Hair Care",
    description: "Soap-nut based shampoo that cleans gently and leaves hair soft. Free from sulphates. 250 ml.",
    images: [ph("Shikakai Shampoo", "#8a5a3a", "#4a2c1a")], stock: 0 },
  { id: 7, name: "Chyawanprash", price: 399, category: "Wellness",
    description: "Traditional amla jam with over 40 herbs, enjoyed daily for strength and immunity. 500 g jar.",
    images: [ph("Chyawanprash", "#5a2a14", "#2a1208")], stock: 18 },
  { id: 8, name: "Tulsi Ginger Tea", price: 179, category: "Wellness",
    description: "Caffeine-free herbal tea with holy basil, ginger and cardamom. 25 tea bags.",
    images: [ph("Tulsi Ginger Tea", "#6a7a2a", "#34401a")], stock: 3 }
];

/* ============ CART (localStorage key: neo_cart) ============ */
const CART_KEY = "neo_cart";
const getCart = () => { try { const c = JSON.parse(localStorage.getItem(CART_KEY)); return Array.isArray(c) ? c : []; } catch { return []; } };
const saveCart = c => { try { localStorage.setItem(CART_KEY, JSON.stringify(c)); } catch {} updateBadge(); };
const byId = id => PRODUCTS.find(p => String(p.id) === String(id));
const inCart = id => getCart().some(i => String(i.id) === String(id));
const cartCount = () => getCart().reduce((n, i) => n + i.qty, 0);
function addToCart(id, qty = 1) {
  const p = byId(id); if (!p || p.stock < 1) return;
  const c = getCart(), it = c.find(i => String(i.id) === String(id));
  if (it) it.qty = Math.min(p.stock, it.qty + qty); else c.push({ id: p.id, qty: Math.min(p.stock, qty) });
  saveCart(c);
}
function setQty(id, qty) {
  const p = byId(id); let c = getCart();
  if (qty < 1) c = c.filter(i => String(i.id) !== String(id));
  else c.forEach(i => { if (String(i.id) === String(id)) i.qty = Math.min(p ? p.stock : qty, qty); });
  saveCart(c);
}
function cartLines() {
  return getCart().map(i => ({ p: byId(i.id), qty: i.qty })).filter(l => l.p);
}
const cartTotal = () => cartLines().reduce((s, l) => s + l.p.price * l.qty, 0);

/* ============ HELPERS ============ */
const $ = s => document.querySelector(s);
const app = $("#app");
const esc = s => String(s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const money = n => CONFIG.currency + Number(n).toLocaleString("en-IN");
const FALLBACK = ph("No image", "#a89878", "#6e5f46");
const img = (src, alt) => `<img src="${esc(src)}" alt="${esc(alt)}" loading="lazy" onerror="this.onerror=null;this.src='${FALLBACK}'">`;
function updateBadge() { $("#count").textContent = cartCount(); }
let filter = "All", qtyChoice = 1, activeImg = 0;

function cardHTML(p) {
  const out = p.stock < 1, added = inCart(p.id);
  return `<article class="card" data-go="#/product/${p.id}" tabindex="0">
    <div class="img">${img(p.images[0] || FALLBACK, p.name)}</div>
    <div class="body"><span class="cat">${esc(p.category)}</span><h3>${esc(p.name)}</h3>
    <span class="price">${money(p.price)}</span>
    <button class="btn ${added ? "in-cart" : "btn-primary"}" data-add="${p.id}" ${out ? "disabled" : ""}>${out ? "Out of stock" : added ? "In Cart ✓" : "Add to Cart"}</button></div></article>`;
}

/* ============ VIEWS ============ */
function viewHome() {
  const cats = ["All", ...new Set(PRODUCTS.map(p => p.category))];
  const list = PRODUCTS.filter(p => filter === "All" || p.category === filter);
  app.innerHTML = `
  <section class="hero"><div class="wrap">
    <h1>${esc(CONFIG.storeName)}</h1><p>${esc(CONFIG.tagline)}</p>
    <a class="btn btn-primary" href="#shop" data-scroll>Shop products</a></div></section>
  <section class="section" id="shop"><div class="wrap">
    <h2>Our products</h2>
    <div class="chips" role="group" aria-label="Filter by category">${cats.map(c => `<button class="chip ${c === filter ? "on" : ""}" data-filter="${esc(c)}">${esc(c)}</button>`).join("")}</div>
    ${list.length ? `<div class="grid">${list.map(cardHTML).join("")}</div>` : `<p class="empty">No products in this category yet.</p>`}
  </div></section>`;
}

function viewProduct(id) {
  const p = byId(id);
  if (!p) { app.innerHTML = `<div class="wrap empty"><h2>Product not found</h2><p><a class="crumb" href="#/">Back to all products</a></p></div>`; return; }
  const imgs = p.images.length ? p.images : [FALLBACK];
  const max = Math.max(1, p.stock), out = p.stock < 1;
  const related = PRODUCTS.filter(r => r.category === p.category && r.id !== p.id).slice(0, 4);
  app.innerHTML = `<div class="wrap">
  <a class="crumb" href="#/">‹ All products</a>
  <div class="pdp">
    <div><div class="main-img" id="mainImg">${img(imgs[activeImg] || imgs[0], p.name)}</div>
      ${imgs.length > 1 ? `<div class="thumbs">${imgs.map((s, i) => `<button class="${i === activeImg ? "on" : ""}" data-thumb="${i}" aria-label="Show image ${i + 1}">${img(s, "")}</button>`).join("")}</div>` : ""}</div>
    <div><span class="cat">${esc(p.category)}</span><h1>${esc(p.name)}</h1><div class="price">${money(p.price)}</div>
      <p class="desc">${esc(p.description)}</p>
      <div class="stock ${p.stock > 0 && p.stock <= 5 ? "low" : ""}">${out ? "Currently out of stock" : p.stock <= 5 ? `Only ${p.stock} left` : "In stock"}</div>
      <div class="buy">
        <div class="qty"><button data-q="-1" aria-label="Decrease quantity">−</button><span id="q">${Math.min(qtyChoice, max)}</span><button data-q="1" aria-label="Increase quantity">+</button></div>
        <button class="btn ${inCart(p.id) ? "in-cart" : "btn-primary"}" data-add-qty="${p.id}" ${out ? "disabled" : ""}>${out ? "Out of stock" : inCart(p.id) ? "In Cart ✓" : "Add to Cart"}</button>
        ${inCart(p.id) ? `<a class="btn btn-line" href="#/cart">View cart</a>` : ""}
      </div></div></div>
  ${related.length ? `<section class="section"><h2>Related products</h2><div class="grid">${related.map(cardHTML).join("")}</div></section>` : ""}
  </div>`;
}

function viewCart() {
  const lines = cartLines();
  if (!lines.length) { app.innerHTML = `<div class="wrap"><h1 class="page-title">Your cart</h1><div class="empty"><p>Your cart is empty.</p><p style="margin-top:16px"><a class="btn btn-dark" href="#/">Browse products</a></p></div></div>`; return; }
  app.innerHTML = `<div class="wrap"><h1 class="page-title">Your cart</h1>
  ${lines.map(({ p, qty }) => `<div class="row">
    ${img(p.images[0] || FALLBACK, p.name)}
    <div class="name-wrap" style="grid-area:n"><a class="name" href="#/product/${p.id}">${esc(p.name)}</a><div class="cat">${money(p.price)} each</div></div>
    <div class="qtyc"><div class="qty"><button data-cq="${p.id}" data-d="-1" aria-label="Decrease">−</button><span>${qty}</span><button data-cq="${p.id}" data-d="1" aria-label="Increase" ${qty >= p.stock ? "disabled" : ""}>+</button></div></div>
    <strong class="lt">${money(p.price * qty)}</strong>
    <button class="remove rm" data-rm="${p.id}">Remove</button></div>`).join("")}
  <div class="total-bar"><div>Total<br><strong>${money(cartTotal())}</strong></div><a class="btn btn-primary" href="#/checkout">Go to checkout</a></div></div>`;
}

function viewCheckout() {
  const lines = cartLines();
  if (!lines.length) { location.hash = "#/cart"; return; }
  app.innerHTML = `<div class="wrap"><h1 class="page-title">Checkout</h1>
  <div class="co">
    <form class="panel" id="coForm"><h2>Your details</h2>
      <label for="f-name">Name</label><input id="f-name" name="name" required autocomplete="name">
      <label for="f-email">Email</label><input id="f-email" name="email" type="email" required autocomplete="email">
      <label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" required autocomplete="tel">
      <label for="f-addr">Address</label><textarea id="f-addr" name="address" rows="3" required autocomplete="street-address"></textarea>
      <label for="f-notes">Notes (optional)</label><textarea id="f-notes" name="notes" rows="2"></textarea>
      <div id="coMsg" role="alert"></div>
      <button class="btn btn-primary" id="coBtn" type="submit" style="margin-top:20px;width:100%">Place order</button>
    </form>
    <aside class="panel"><h2>Order summary</h2>
      ${lines.map(({ p, qty }) => `<div class="sum-line"><span>${esc(p.name)} × ${qty}</span><span>${money(p.price * qty)}</span></div>`).join("")}
      <div class="sum-total"><span>Total</span><span>${money(cartTotal())}</span></div></aside>
  </div></div>`;
}

async function submitOrder(form) {
  const btn = $("#coBtn"), msg = $("#coMsg"), lines = cartLines();
  if (!lines.length) return;
  btn.disabled = true; btn.textContent = "Sending…"; msg.innerHTML = "";
  const f = new FormData(form);
  const payload = {
    name: f.get("name"), email: f.get("email"), phone: f.get("phone"), address: f.get("address"), notes: f.get("notes") || "",
    store: CONFIG.storeName,
    items: lines.map(({ p, qty }) => ({ id: p.id, name: p.name, price: p.price, qty, subtotal: p.price * qty })),
    total: CONFIG.currency + cartTotal()
  };
  payload.order_summary = payload.items.map(i => `${i.name} x${i.qty} = ${CONFIG.currency}${i.subtotal}`).join("\n");
  try {
    if (CONFIG.formspreeUrl.includes("YOUR_FORM_ID")) throw new Error("Add your Formspree URL in CONFIG at the top of the file.");
    const r = await fetch(CONFIG.formspreeUrl, { method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, body: JSON.stringify(payload) });
    if (!r.ok) throw new Error("The order could not be sent. Please try again.");
    saveCart([]);
    app.innerHTML = `<div class="wrap success"><h1>Thank you, order received!</h1><p>We will contact you shortly to confirm your order.<br>Taking you back to the home page…</p></div>`;
    setTimeout(() => { location.hash = "#/"; }, 3000);
  } catch (e) {
    msg.innerHTML = `<div class="msg err">${esc(e.message || "Something went wrong. Please try again.")}</div>`;
    btn.disabled = false; btn.textContent = "Place order";
  }
}

/* ============ ROUTER ============ */
function route() {
  const [, page, arg] = (location.hash || "#/").split("/");
  if (page === "product") { activeImg = 0; qtyChoice = 1; viewProduct(arg); }
  else if (page === "cart") viewCart();
  else if (page === "checkout") viewCheckout();
  else viewHome();
  document.title = CONFIG.storeName;
  window.scrollTo(0, 0);
  updateBadge();
}
function rerender() { const y = scrollY; const [, page, arg] = (location.hash || "#/").split("/");
  if (page === "product") viewProduct(arg); else if (page === "cart") viewCart(); else if (page === "checkout") return; else viewHome();
  scrollTo(0, y); }

/* ============ EVENTS ============ */
document.addEventListener("click", e => {
  const t = e.target;
  let el;
  if ((el = t.closest("[data-add]"))) { e.stopPropagation(); addToCart(el.dataset.add); rerender(); return; }
  if ((el = t.closest("[data-add-qty]"))) { addToCart(el.dataset.addQty, qtyChoice); rerender(); return; }
  if ((el = t.closest("[data-filter]"))) { filter = el.dataset.filter; rerender(); return; }
  if ((el = t.closest("[data-thumb]"))) { activeImg = +el.dataset.thumb; rerender(); return; }
  if ((el = t.closest("[data-q]"))) {
    const [, , id] = location.hash.split("/"), p = byId(id);
    qtyChoice = Math.max(1, Math.min(p ? Math.max(1, p.stock) : 99, qtyChoice + +el.dataset.q)); $("#q").textContent = qtyChoice; return;
  }
  if ((el = t.closest("[data-cq]"))) { const it = getCart().find(i => String(i.id) === el.dataset.cq); if (it) setQty(el.dataset.cq, it.qty + +el.dataset.d); rerender(); return; }
  if ((el = t.closest("[data-rm]"))) { setQty(el.dataset.rm, 0); rerender(); return; }
  if ((el = t.closest("[data-scroll]"))) { e.preventDefault(); $("#shop").scrollIntoView({ behavior: "smooth" }); return; }
  if ((el = t.closest("[data-go]"))) { location.hash = el.dataset.go; }
});
document.addEventListener("keydown", e => {
  if (e.key === "Enter" && e.target.matches && e.target.matches(".card")) location.hash = e.target.dataset.go;
});
document.addEventListener("submit", e => { if (e.target.id === "coForm") { e.preventDefault(); submitOrder(e.target); } });
window.addEventListener("hashchange", route);

/* ============ INIT ============ */
$("#logo").textContent = CONFIG.storeName;
$("#foot").textContent = "© " + new Date().getFullYear() + " " + CONFIG.storeName;
route();
</script>
</body>
</html>
